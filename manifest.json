{
  "manifest_version": 3,
  "name": "Multi-Column Reader",
  "version": "1.0",
  "description": "Read articles in a multi-column magazine layout",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://www.theverge.com/*",
    "https://theverge.com/*",
    "http://localhost:4321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Multi-Column Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.theverge.com/*",
        "http://localhost:4321/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["reader.css"],
      "matches": [
        "*://*.theverge.com/*",
        "http://localhost:4321/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
